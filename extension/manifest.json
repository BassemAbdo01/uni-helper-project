{
  "manifest_version": 3,
  "name": "Nexora Sync",
  "version": "3.2.0",
  "description": "Import your courses, deadlines, lectures and announcements from Brightspace into Nexora. Works with any university's Brightspace.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*.onrender.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexora Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://uni-helper-project.onrender.com/*"
      ],
      "js": [
        "nexora-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
