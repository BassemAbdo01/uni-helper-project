{
  "manifest_version": 3,
  "name": "Nexora Sync",
  "version": "1.2.0",
  "description": "Nexora Smart Sync, background lecture intelligence, and Nexora Bridge, resilient lecture intelligence, and full-screen multimodal AI Tutor.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://brightspace.carleton.ca/*",
    "https://*.brightspace.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexora Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://brightspace.carleton.ca/*",
        "https://*.brightspace.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.onrender.com/*",
        "http://127.0.0.1:5000/*"
      ],
      "js": [
        "nexora-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
