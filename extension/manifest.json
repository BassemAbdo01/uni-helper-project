{
  "manifest_version": 3,
  "name": "Nexora Sync",
  "version": "0.2.0",
  "description": "Discovers Brightspace courses and imports visible course content into Nexora.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://brightspace.carleton.ca/*",
    "https://*.brightspace.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Nexora Sync"},
  "content_scripts": [{
    "matches": ["https://brightspace.carleton.ca/*", "https://*.brightspace.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
