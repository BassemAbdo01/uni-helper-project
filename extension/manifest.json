{
  "manifest_version": 3,
  "name": "Nexora Sync",
  "version": "0.5.0",
  "description": "Imports Carleton Brightspace courses and imports structured course content and private file copies with non-disruptive background scanning.",
  "permissions": ["storage", "alarms", "tabs", "windows"],
  "host_permissions": [
    "https://brightspace.carleton.ca/*",
    "https://*.brightspace.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Nexora Sync"},
  "content_scripts": [{
    "matches": ["https://brightspace.carleton.ca/*", "https://*.brightspace.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
